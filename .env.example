# VirusTotal API key: https://www.virustotal.com/gui/my-apikey
VT_API_KEY=your_api_key_here

# Rate limit: requests per minute (free tier ~4/min)
VT_REQUESTS_PER_MINUTE=4

# AbuseIPDB: https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=
ABUSEIPDB_MAX_AGE_DAYS=90

# AlienVault OTX: https://otx.alienvault.com (Settings → API Integration)
OTX_API_KEY=

# URLhaus (abuse.ch): Auth-Key gratuita da https://auth.abuse.ch/
URLHAUS_AUTH_KEY=

# Rate limit condiviso per AbuseIPDB, OTX e URLhaus
OSINT_REQUESTS_PER_MINUTE=30
